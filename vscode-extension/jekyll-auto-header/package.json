{"name":"jekyll-auto-header","displayName":"Jekyll Auto Header","description":"Automatically insert Jekyll front matter when creating Markdown files in _posts, including non-standard filenames.","version":"0.1.0","publisher":"ly5681672-max","engines":{"vscode":"^1.90.0"},"categories":["Other"],"keywords":["github.dev","web-extension","jekyll","markdown","front-matter"],"browser":"./dist/web/extension.js","activationEvents":["workspaceContains:_posts"],"main":"./dist/node/extension.js","contributes":{"commands":[{"command":"jekyll-auto-header.insertHeader","title":"Jekyll Auto Header: Insert Header"}]},"scripts":{"build:web":"esbuild src/extension.js --bundle --platform=browser --format=cjs --external:vscode --outfile=dist/web/extension.js","build:node":"esbuild src/extension.js --bundle --platform=node --format=cjs --external:vscode --outfile=dist/node/extension.js","build":"npm run build:web && npm run build:node","test":"node --test test/*.test.js"},"devDependencies":{"esbuild":"^0.25.0"}}